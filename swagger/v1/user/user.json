{
    "swagger": "2.0",
    "info": {
        "description": "user module api document",
        "title": "user api",
        "version": "1.0.0"
    },
    "tags": [
        {
            "name": "User",
            "description": "用户相关接口"
        },
        {
            "name": "File",
            "description": "文件相关接口"
        }
    ],
    "paths": {
        "/user": {
            "get": {
                "tags": [
                    "User"
                ],
                "operationId": "get_user_list",
                "x-swagger-router-controller": "src.controllers.user.Users",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "keyword",
                        "description": "关键字",
                        "in": "query",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "name": "page",
                        "description": "页码",
                        "in": "query",
                        "required": true,
                        "type": "integer"
                    },
                    {
                        "name": "limit",
                        "description": "每页显示的数量",
                        "in": "query",
                        "required": true,
                        "type": "integer"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "list": {
                                    "type": "object"
                                },
                                "total": {
                                    "type": "integer"
                                },
                                "page": {
                                    "type": "integer"
                                },
                                "limit": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/file/download": {
            "get": {
                "tags": [
                    "File"
                ],
                "operationId": "download_file",
                "x-swagger-router-controller": "src.controllers.file.Files",
                "produces": [
                    "application/json"
                ],
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "文件下载成功",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "Content-Disposition": {
                                "type": "string",
                                "description": "用于指定下载的文件名，例如: attachment; filename=data.zip"
                            }
                        }
                    },
                    "404": {
                        "description": "文件未找到"
                    }
                }
            }
        }
    }
}
